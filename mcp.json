{
  "mcpServers": {
    "alessandro-volta-ai": {
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "--quiet"
      ],
      "env": {
        "RUST_LOG": "info",
        "TITAN_PROTOCOL": "VOLTA",
        "TARGET_CHAIN": "Sui",
        "FIPS_203_LEVEL": "ML-KEM-768",
        "FIPS_204_LEVEL": "ML-DSA-65"
      },
      "tools": [
        {
          "name": "simulate_voltaic_pile_emf",
          "description": "Computes open-circuit electromotive force (EMF) generated by n-stacked zinc-copper saline disk pairs",
          "parameters": {
            "type": "object",
            "properties": {
              "cell_pair_count": {
                "type": "integer"
              },
              "electrolyte_salinity": {
                "type": "number"
              }
            },
            "required": [
              "cell_pair_count"
            ]
          }
        },
        {
          "name": "measure_electrochemical_contact_potential",
          "description": "Evaluates Volta contact potential series across dissimilar metals in galvanic series",
          "parameters": {
            "type": "object",
            "properties": {
              "metal_anode": {
                "type": "string"
              },
              "metal_cathode": {
                "type": "string"
              }
            },
            "required": [
              "metal_anode",
              "metal_cathode"
            ]
          }
        }
      ]
    }
  }
}